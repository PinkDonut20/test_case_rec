# api | hf | hybrid | heuristic
EXTRACTOR_MODE=hybrid

# lighton | easyocr
OCR_BACKEND=lighton
USE_GPU=0
OCR_CONF_THRESHOLD=0.20
OCR_MIN_BOX_AREA=60
LIGHTON_MODEL=lightonai/LightOnOCR-2-1B
HF_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# для EXTRACTOR_MODE=api или hybrid
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
