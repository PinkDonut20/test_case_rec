# hf | heuristic | hybrid | api
EXTRACTOR_MODE=hf

# lighton | easyocr
OCR_BACKEND=lighton
USE_GPU=0
OCR_CONF_THRESHOLD=0.20
OCR_MIN_BOX_AREA=60
LIGHTON_MODEL=lightonai/LightOnOCR-2-1B
HF_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# LLM_* не нужны для обычного запуска.
# Заполняйте только если вручную включаете EXTRACTOR_MODE=api
